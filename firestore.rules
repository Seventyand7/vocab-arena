rules_version = '2';

// ============================================================
// VOCAB QUEST — Firestore Security Rules
//
// 核心原則：每個使用者只能讀寫自己 uid 底下的資料。
// 未登入、或想碰別人 uid 的請求一律拒絕。
//
// 另外因為網站是公開的，這裡再加一層鎖：只有 allowedUids() 白名單
// 內的帳號能存取任何資料。其他人就算用自己的 Google 帳號登入，也讀
// 寫不了任何東西（前端會顯示自己的 UID 並自動登出，方便他跟你申請）。
//
// 這份規則是資料安全的唯一防線（前端的 firebaseConfig 依 Firebase
// 官方設計本來就是公開的，擋不住任何人），所以請務必部署上去：
//   Firebase Console → Firestore Database → 規則 → 貼上後「發布」
// 或用 CLI：firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // 允許使用這個網站的帳號白名單。
    //
    // 要讓某個人可以用：請他登入一次，畫面會顯示他的 UID，把那串
    // 加進下面的清單再重新發布規則即可。要停用就把該行刪掉。
    //
    // 注意：知道 UID 不等於拿到存取權 —— 對方必須真的用擁有那個 UID
    // 的 Google 帳號登入。UID 只是用來指名，不是密碼。
    //
    // 每個人的資料各自存在自己的 users/{uid} 底下，彼此看不到。
    // ------------------------------------------------------------
    function allowedUids() {
      return [
        'tqWxpIUqRLcLT79eoqilhDNANPI3',   // 我自己
        // 'PASTE_ANOTHER_UID_HERE',      // 朋友 A
      ];
    }

    // 必須同時滿足：已登入、資料屬於自己、而且在白名單內。
    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in allowedUids();
    }

    // 單字的基本欄位檢查，避免寫進型別不對的資料
    function isValidWord() {
      let d = request.resource.data;
      return d.original is string
          && d.original.size() > 0
          && d.original.size() <= 200
          && d.translation is string
          && d.masteryLevel is int
          && d.masteryLevel >= 0
          && d.masteryLevel <= 5
          && d.nextReviewAt is timestamp
          && d.createdAt is timestamp
          && d.milestonesDone is map;
    }

    // 使用者根文件（目前沒實際用到，但一併鎖住）
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 單字庫：users/{uid}/vocab/{wordId}
    match /users/{uid}/vocab/{wordId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidWord();
    }

    // 個人設定（含使用者自己的 Gemini API key）：
    // users/{uid}/settings/geminiKey
    match /users/{uid}/settings/{settingId} {
      allow read, write: if isOwner(uid);
    }

    // 以上沒有明確允許的路徑，一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
